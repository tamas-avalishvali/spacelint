{
  "name": "whitespace-ninja",
  "displayName": "Whitespace Ninja",
  "description": "Real-time whitespace linter & formatter: flags trailing whitespace, double spaces, mixed tabs/spaces, extra blank lines, and invisible unicode whitespace, with one-click Quick Fix cleanup.",
  "version": "0.2.0",
  "publisher": "QuickTools",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tamas-avalishvali/spacelint.git"
  },
  "bugs": {
    "url": "https://github.com/tamas-avalishvali/spacelint/issues"
  },
  "homepage": "https://github.com/tamas-avalishvali/spacelint#readme",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "whitespace",
    "trailing whitespace",
    "linter",
    "formatter",
    "double space",
    "mixed indentation",
    "blank lines",
    "invisible characters",
    "unicode whitespace",
    "non-breaking space"
  ],
  "categories": [
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "whitespaceNinja.cleanFile",
        "title": "Whitespace Ninja: Clean Current File"
      },
      {
        "command": "whitespaceNinja.cleanWorkspace",
        "title": "Whitespace Ninja: Clean All Open Files"
      }
    ],
    "configuration": {
      "title": "Whitespace Ninja",
      "properties": {
        "whitespaceNinja.rules.multipleSpaces": {
          "type": "boolean",
          "default": true,
          "description": "Highlight runs of 2+ spaces in the middle of a line (indentation is never flagged)."
        },
        "whitespaceNinja.rules.trailingWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Highlight spaces/tabs at the end of a line."
        },
        "whitespaceNinja.rules.mixedIndentation": {
          "type": "boolean",
          "default": true,
          "description": "Highlight lines whose leading indentation mixes tabs and spaces."
        },
        "whitespaceNinja.rules.extraBlankLines": {
          "type": "boolean",
          "default": true,
          "description": "Highlight consecutive blank lines beyond the configured maximum."
        },
        "whitespaceNinja.rules.invisibleWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Highlight non-breaking spaces and other invisible unicode whitespace characters."
        },
        "whitespaceNinja.maxBlankLines": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Maximum number of consecutive blank lines allowed before they are flagged."
        },
        "whitespaceNinja.maxFileSizeKB": {
          "type": "number",
          "default": 2000,
          "minimum": 0,
          "description": "Skip scanning files larger than this size (in KB) to keep typing responsive."
        },
        "whitespaceNinja.colors.multipleSpaces": {
          "type": "string",
          "default": "rgba(234,0,255,0.3)",
          "description": "Highlight color for multiple-space issues."
        },
        "whitespaceNinja.colors.trailingWhitespace": {
          "type": "string",
          "default": "rgba(255,0,0,0.25)",
          "description": "Highlight color for trailing-whitespace issues."
        },
        "whitespaceNinja.colors.mixedIndentation": {
          "type": "string",
          "default": "rgba(255,165,0,0.3)",
          "description": "Highlight color for mixed-indentation issues."
        },
        "whitespaceNinja.colors.extraBlankLines": {
          "type": "string",
          "default": "rgba(100,120,255,0.15)",
          "description": "Highlight color for extra-blank-line issues."
        },
        "whitespaceNinja.colors.invisibleWhitespace": {
          "type": "string",
          "default": "rgba(255,215,0,0.35)",
          "description": "Highlight color for invisible/unicode whitespace issues."
        },
        "doubleSpaceHighlighter.highlightColor": {
          "type": "string",
          "default": "rgba(234,0,255,0.3)",
          "description": "Deprecated - use whitespaceNinja.colors.multipleSpaces instead.",
          "deprecationMessage": "Renamed to whitespaceNinja.colors.multipleSpaces. Your existing value has been migrated automatically."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run compile",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
